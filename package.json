  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "allure-commandline": "^2.27.0",
    "allure-js-commons": "^3.7.2",
    "allure-playwright": "^3.7.2",
    "dotenv": "^16.4.5",
    "typescript": "^6.0.3"
  }
}